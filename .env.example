# Spark configuration: one file for SparkNode, SparkKids and Spark Bridge.
#
#   ./setup.sh writes .env for you (recommended), or: cp .env.example .env and edit it.
#
# .env is gitignored. Never commit it: it holds passwords, PINs and the Discord bot token.
# Firmware reads it at build time (spark/pio_env.py), so after a change rebuild and reflash.
# SparkNode note: name, passwords, radio, scope and path hash are only the defaults for a NEW
# node (first boot / no saved settings). An existing node keeps what it has; change those on
# its console (USB, the MeshCore app's admin login, or /spark cli).
# Values: no quotes needed; quotes, backslashes, backticks and $ are not allowed in firmware values.

# ----------------------------------------------------------------------------------------------
# Radio and mesh network (SparkNode and SparkKids must match each other and your local mesh)
# Preset "NL" (Dutch MeshCore): 869.618 MHz, 62.5 kHz, SF7, CR5, scope nl, 2-byte path hashes.
SPARK_RADIO_PRESET=NL
SPARK_LORA_FREQ=869.618
SPARK_LORA_BW=62.5
SPARK_LORA_SF=7
SPARK_LORA_CR=5
# Transmit power in dBm (the SenseCAP P1 and T-Deck Plus both allow up to 22).
SPARK_LORA_TX_POWER=22
# Flood scope (region) name, without '#'. Empty = unscoped.
SPARK_SCOPE=nl
# Bytes per hop in flood paths: 1, 2 or 3 (MeshCore "path hash mode" = this minus 1).
SPARK_PATH_HASH_SIZE=2

# ----------------------------------------------------------------------------------------------
# Time zone. setup.sh asks once and writes both keys from your system's zone.
# Firmware (SparkKids clock and message times): a POSIX TZ string, e.g.
#   CET-1CEST,M3.5.0,M10.5.0/3 (Central Europe), GMT0BST,M3.5.0/1,M10.5.0 (UK),
#   EST5EDT,M3.2.0,M11.1.0 (US Eastern). The last line of /usr/share/zoneinfo/<Area/City> is it.
SPARK_TZ=UTC0
# Spark Bridge (daily health line): the IANA name of the same zone, e.g. Europe/Amsterdam.
BRIDGE_TZ=UTC

# ----------------------------------------------------------------------------------------------
# SparkNode (SenseCAP Solar Node P1 room server + relay)
# Name shown in adverts and in the MeshCore app (BLE name becomes "MeshCore-<name>").
SPARK_NODE_NAME=SparkNode
# Advertised position in degrees (0.0 = none).
SPARK_NODE_LAT=0.0
SPARK_NODE_LON=0.0
# Admin password (room admin login, remote CLI). Required, max 15 characters.
SPARK_ADMIN_PASSWORD=
# Room (guest) password your tribe logs in with. Max 15 characters.
SPARK_ROOM_PASSWORD=
# BLE PIN for the bridge link: 6 digits, not starting with 0. Empty = BLE stays off until you
# run "set ble.pin <pin>" on the node's USB console. A PIN set over USB always wins.
SPARK_BLE_PIN=

# ----------------------------------------------------------------------------------------------
# SparkKids (LilyGO T-Deck Plus)
# The SparkNode's public key, 64 hex digits (node USB console: "get public.key"; setup.sh can
# read it for you after flashing the node).
KIDS_ROOM_KEY=
# Name of the room on the kids' screen. Empty = SPARK_NODE_NAME.
KIDS_ROOM_NAME=
# Password the kids' devices log in with. Empty = SPARK_ROOM_PASSWORD.
KIDS_ROOM_PASSWORD=
# Parent PIN for the settings screen and the USB console: 4 to 8 digits. Required.
KIDS_PARENT_PIN=
# Public channel on the kids' devices: 0 = off (default), 1 = on. Parents can change it later
# under Parent settings > Public channel; that choice is kept on the device.
KIDS_PUBLIC_ENABLED=0
# Maximum Public posts per hour from one device (1..16; at least 30 s apart).
KIDS_PUBLIC_PER_HOUR=6

# ----------------------------------------------------------------------------------------------
# Spark Bridge (Discord <-> SparkNode over BLE, USB serial or TCP)
# Bot token of a dedicated Discord application (Developer Portal > Bot). Secret.
DISCORD_TOKEN=
# Discord server ids the bridge may act in, comma separated. Empty = acts nowhere.
BRIDGE_GUILD_IDS=
# How the bridge reaches the node: ble, serial or tcp (tcp = the stub node, for testing).
BRIDGE_TRANSPORT=ble
# BLE: substring of the node's BLE name. Empty = SPARK_NODE_NAME.
BRIDGE_BLE_NAME=
# BLE: Linux MAC address of the node (optional, wins over the name).
BRIDGE_BLE_ADDRESS=
# Serial: port of the node, e.g. /dev/ttyACM0 or /dev/cu.usbmodem1101.
BRIDGE_SERIAL_PORT=
BRIDGE_TCP_HOST=127.0.0.1
BRIDGE_TCP_PORT=5000
# Name of the webhook the bridge posts mesh messages with.
BRIDGE_WEBHOOK_NAME=Spark Bridge
# Channel defaults: messages per minute for newly configured channels (/spark ratelimit).
BRIDGE_DEFAULT_PER_MINUTE=3
# Global cap on Public transmissions from Discord, all channels together (0 = off).
BRIDGE_PUBLIC_PER_MINUTE=3
BRIDGE_PUBLIC_BURST=3
# Daily health line and battery samples (local time in BRIDGE_TZ, see "Time zone" above).
BRIDGE_HEALTH_DAWN=07:00
BRIDGE_HEALTH_AFTERNOON=15:00
BRIDGE_HEALTH_REPORT=15:05
BRIDGE_HEALTH_SAMPLE_MINUTES=10
# SQLite state file, relative to this file's directory unless absolute.
BRIDGE_DB_PATH=spark-bridge.db
# 1 lifts the bridge-side CLI denylist (password, set prv.key, erase, ...). Keep 0.
BRIDGE_ALLOW_DANGEROUS_CLI=0
# Link supervision (advanced).
BRIDGE_GIVE_UP_MINUTES=10
BRIDGE_CONNECT_TIMEOUT=45
BRIDGE_WATCHDOG_SECONDS=5
BRIDGE_BLE_DIRECT_AFTER=3
BRIDGE_POLL_FAILURES=2
